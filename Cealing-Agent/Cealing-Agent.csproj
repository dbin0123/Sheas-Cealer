<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 必须是 WinExe（GUI 子系统），不能是 Exe：控制台子系统的 exe 被
         ShellExecute+RunAs 拉起时（UseShellExecute=true 下 CreateNoWindow 被忽略），
         Windows 会给它分配一个常驻控制台窗口，表现为弹一个全是 agent 日志的命令行。
         agent 没有交互界面、日志走 AgentLog 的文件，WinExe 不分配控制台；
         Unix 没有子系统概念，产物行为不变。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Cealing_Agent</RootNamespace>
    <AssemblyName>Cealing-Agent</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 本机只有 .NET 10 运行时（没有 8.0），Task 11 的 dotnet run 要能启动 -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cealing-Core\Cealing-Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <!-- 必须是程序集简单名（和 <AssemblyName> 一致，带连字符），不是命名空间的下划线形式，否则 IVT 不生效 -->
      <_Parameter1>Sheas-Cealer-Nix.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- agent 在 Windows 上以管理员身份运行，在 macOS/Linux 上作为 root daemon 运行 -->
  </ItemGroup>

</Project>
